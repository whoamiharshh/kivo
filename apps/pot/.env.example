# Copy to .env.local and fill in. Nothing here is a real secret.
#
# NEXT_PUBLIC_* values are compiled into the browser bundle and are public by
# design. Everything without that prefix is server-only and must never get it:
# the trust layer's guarantees collapse if these reach the browser.

# ─── Privy: sign-in, passkeys, and sponsored fees ─────────────────────────────
# dashboard.privy.io → your app → App ID.
# Required dashboard settings:
#   Login methods      → Passkey on (primary), Google and Email on (fallbacks)
#   Fee sponsorship    → on, covering Monad Testnet
#   User management → Authentication → Advanced
#                      → "Return user data in an identity token" ON
#                        (the server reads the wallet address from that token)
NEXT_PUBLIC_PRIVY_APP_ID=

# Server-only. Dashboard → Settings → Basics → App secret.
PRIVY_APP_SECRET=

# Server-only. Dashboard → Settings → Basics → Verification key (SPKI PEM).
# Used to verify access and identity tokens without a network round trip.
# Keep the literal \n escapes if you paste it on one line.
PRIVY_VERIFICATION_KEY=

# ─── Trust layer: the server's signing key ────────────────────────────────────
# Server-only. One key, used by every contract that gates an action on a
# signature. It authorises a joiner once the server has checked their invite
# code against pots_private, and it signs the behaviour, condition, income,
# claim and streak-day attestations. It holds no money, owns no contract, and
# cannot spend, approve, close or refund anything.
#
#   openssl rand -hex 32      then prefix the result with 0x
#
# The matching ADDRESS is what the deploy script wants for TRUST_SIGNER,
# POOL_ATTESTER, RECORDER and INSURER_SIGNER. The remaining deploy roles
# (ARBITRATOR, SAVINGS_ADMIN, INSURER) are people, not this key.
TRUST_SIGNER_KEY=

# ─── Audit log: the salt that anonymises addresses ───────────────────────────
# Server-only. Blocked requests are recorded with a salted SHA-256 of the
# caller's IP, never the address itself.
#
# This salt is what makes the digest unguessable. IPv4 is only ~4.3 billion
# addresses, so an UNSALTED sha256 of one can be reversed by brute force in
# seconds — the salt is the entire protection, which is why it is a secret and
# why it is not NEXT_PUBLIC_.
#
#   openssl rand -hex 32
#
# Leave it blank and no address is logged at all (the server says so once on
# start-up). Rotating it makes old entries uncorrelatable with new ones.
IP_HASH_SALT=

# ─── The app's own address ────────────────────────────────────────────────────
# Used to refuse API calls that came from another site. Leave blank locally;
# same-origin requests are always allowed. Set it to the canonical production
# origin on Vercel, with no trailing slash:
#
#   NEXT_PUBLIC_APP_URL=https://your-project.vercel.app
NEXT_PUBLIC_APP_URL=

# ─── Contracts (filled in after the deploy) ───────────────────────────────────
# `forge script script/Deploy.s.sol` prints every address below in one run.
#
# Each feature checks its OWN address, so a half-filled list is not fatal: the
# screens whose contract is missing say "not set up yet" and the rest work.

# Test Rupee — the test money every feature moves. Needed by all of them.
NEXT_PUBLIC_TEST_RUPEE_ADDRESS=
# Pot — the group money box
NEXT_PUBLIC_POT_MANAGER_ADDRESS=
# SocialPay — person-to-person payments, held until confirmed
NEXT_PUBLIC_SOCIAL_PAY_ADDRESS=
# Gift — money released when a condition is attested
NEXT_PUBLIC_GIFT_ADDRESS=
# BehaviourSavings — save with a stake on keeping a habit
NEXT_PUBLIC_BEHAVIOUR_SAVINGS_ADDRESS=
# SalaryStream — pay that accrues over time instead of in one lump
NEXT_PUBLIC_SALARY_STREAM_ADDRESS=
# IncomeShare — repay a share of income (records only, moves no money)
NEXT_PUBLIC_INCOME_SHARE_ADDRESS=
# MicroCover — small cover against a named event
NEXT_PUBLIC_MICRO_COVER_ADDRESS=
# AccountabilityPool — a group streak with a stake on it
NEXT_PUBLIC_ACCOUNTABILITY_POOL_ADDRESS=

# The block the contracts were deployed in. Keeps the feeds' log scan cheap.
NEXT_PUBLIC_DEPLOY_BLOCK=0

# The address that may resolve disputes. A placeholder for a decentralised
# arbitration layer — see README, "Honest limitations".
NEXT_PUBLIC_ARBITRATOR_ADDRESS=

# ─── Supabase ─────────────────────────────────────────────────────────────────
# Pot uses this for names and memo text only, and works without it.
# SocialPay's trust layer REQUIRES it: identity, payments, contacts, the audit
# log and the send limits all live here.
#
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Dashboard → Project Settings → API keys → secret / service_role.
# Bypasses RLS, so it is the one value in this file that must never be public.
SUPABASE_SECRET_KEY=
